---
import SectionHead from './SectionHead.astro';
import { toolbox } from '../data/site';
const left = toolbox.slice(0, 3);
const right = toolbox.slice(3);
let pin = 0;
const L = left.map((g) => ({ ...g, pins: g.items.map((n) => ({ n, p: ++pin })) }));
const total = pin + right.reduce((a, g) => a + g.items.length, 0);
let rp = total + 1;
const R = right.map((g) => ({ ...g, pins: g.items.map((n) => ({ n, p: --rp })) }));
---
<section id="toolbox" class="relative border-y-2 border-ink bg-sheet py-20 sm:py-28" aria-labelledby="toolbox-title">
  <div class="wrap">
    <SectionHead id="toolbox-title" kicker="§05 — Pinout" title="Toolbox, as<br/>a datasheet" note={`${total} pins, all connected`} />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_260px_minmax(0,1fr)] lg:gap-0" data-reveal>
      <!-- left pins -->
      <div class="order-2 flex flex-col gap-6 lg:order-1">
        {L.map((g) => (
          <div>
            <p class="fig mb-2 lg:pr-12 lg:text-right">{g.group}</p>
            <ul class="flex flex-col gap-1">
              {g.pins.map((x) => (
                <li class="flex items-center gap-2 font-mono text-[13px] lg:flex-row-reverse">
                  <span class="hidden h-[3px] w-10 shrink-0 bg-ink lg:block"></span>
                  <span class="w-7 shrink-0 text-right text-[11px] text-muted lg:text-left">{x.p}</span>
                  <span class="font-bold lg:ml-auto">{x.n}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <!-- chip body -->
      <div class="order-1 lg:order-2">
        <div class="relative flex h-full min-h-56 flex-col items-center justify-center bg-ink p-6 text-center text-hazard lg:sticky lg:top-28 lg:h-[420px]">
          <span class="absolute left-1/2 top-0 h-5 w-10 -translate-x-1/2 rounded-b-full bg-sheet" aria-hidden="true"></span>
          <span class="absolute left-4 top-4 size-3 rounded-full bg-hazard" aria-hidden="true"></span>
          <p class="font-display text-4xl font-black" style="font-stretch:125%">KV-01</p>
          <p class="mt-2 font-mono text-[11px] font-bold uppercase leading-snug text-[#F4F1E8]">Embedded systems<br/>engineer</p>
          <p class="mt-4 font-mono text-[10px] text-[#B9B9C4]">IIIT SURAT · ECE · 2025<br/>REV 2026 · PUNE</p>
          <div class="barcode mt-5 h-8 w-32 bg-transparent invert" aria-hidden="true"></div>
        </div>
      </div>
      <!-- right pins -->
      <div class="order-3 flex flex-col gap-6">
        {R.map((g) => (
          <div>
            <p class="fig mb-2 lg:pl-12">{g.group}</p>
            <ul class="flex flex-col gap-1">
              {g.pins.map((x) => (
                <li class="flex items-center gap-2 font-mono text-[13px]">
                  <span class="hidden h-[3px] w-10 shrink-0 bg-ink lg:block"></span>
                  <span class="w-7 shrink-0 text-right text-[11px] text-muted lg:text-left">{x.p}</span>
                  <span class="font-bold">{x.n}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
