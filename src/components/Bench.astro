---
import SectionHead from './SectionHead.astro';
const marquee = ['Line-following robot', 'Wall-following robot', 'Self-leveling platform', 'CNC plotter', 'Smart Quad Drone', 'P10 LED matrix', 'Sensor validation rig', 'Presence system', 'AC power meter', 'PWM motor control', 'Servo control', 'ADC sensing'];
---
<section id="bench" class="relative py-20 sm:py-28" aria-labelledby="bench-title">
  <div class="wrap">
    <SectionHead id="bench-title" kicker="§04 — The bench" title="Width: robots,<br/>rigs &amp; side quests" note="35+ projects and counting" noteColor="blue" />
  </div>

  <div class="overflow-hidden border-y-2 border-ink bg-hazard py-3" aria-hidden="true">
    <div class="rf-marquee flex w-max gap-8 whitespace-nowrap font-display text-2xl font-black uppercase" style="font-stretch:118%">
      {[...marquee, ...marquee].map((m) => (<span class="flex items-center gap-8">{m}<span class="text-signal">✦</span></span>))}
    </div>
  </div>

  <div class="wrap mt-14">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-6" data-reveal-stagger>
      <article class="sheet sheet-shadow-blue grid grid-cols-1 items-center gap-4 p-5 sm:grid-cols-[200px_minmax(0,1fr)] md:col-span-4 sm:p-7">
        <svg viewBox="0 0 320 320" class="mx-auto w-full max-w-[220px] border-2 border-ink grid-paper" aria-hidden="true">
          <rect x="105" y="270" width="110" height="30" fill="#0B0B14" />
          <g class="rf-arm1">
            <rect x="146" y="150" width="28" height="118" fill="#FF220F" stroke="#0B0B14" stroke-width="3" />
            <g class="rf-arm2">
              <rect x="149" y="68" width="22" height="98" fill="#0000C4" stroke="#0B0B14" stroke-width="3" />
              <g class="rf-grip">
                <rect x="139" y="48" width="12" height="32" fill="#0B0B14" /><rect x="169" y="48" width="12" height="32" fill="#0B0B14" />
                <circle cx="160" cy="78" r="9" fill="#FEEA4D" stroke="#0B0B14" stroke-width="3" />
              </g>
              <circle cx="160" cy="162" r="11" fill="#FEEA4D" stroke="#0B0B14" stroke-width="3" />
            </g>
            <circle cx="160" cy="262" r="14" fill="#FEEA4D" stroke="#0B0B14" stroke-width="3" />
          </g>
        </svg>
        <div>
          <p class="fig">Robotics · closed-loop control</p>
          <h3 class="mt-2 font-display text-2xl font-extrabold leading-tight sm:text-3xl">Robots that hold a line</h3>
          <p class="mt-3 text-[15px] leading-relaxed">A self-leveling platform plus line-following and wall-following robots: sense, decide, actuate, repeat, with PWM motor and servo control underneath.</p>
          <ul class="mt-4 flex flex-wrap gap-2"><li class="chip">Self-leveling</li><li class="chip">Line-follow</li><li class="chip">Wall-follow</li></ul>
        </div>
      </article>

      <article class="sheet p-5 md:col-span-2 sm:p-7">
        <p class="fig">Mechanics · debug</p>
        <h3 class="mt-2 text-xl font-extrabold">CNC plotter</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">Root-caused motion artifacts to tolerance and gear-meshing faults; fixed with iterative 3D-printed part revisions.</p>
      </article>

      <article class="sheet p-5 md:col-span-2 sm:p-7">
        <p class="fig">Aerial · PHN</p>
        <h3 class="mt-2 text-xl font-extrabold">Smart Quad Drone</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">Worked on PHN Technology's quadcopter kit.</p>
      </article>

      <article class="sheet p-5 md:col-span-2 sm:p-7">
        <p class="fig">Breadth · 2025</p>
        <h3 class="mt-2 text-xl font-extrabold">35+ embedded builds</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">Digital and ADC sensor interfacing, PWM motor and servo control, SPI, I2C and UART.</p>
      </article>

      <article class="border-2 border-ink bg-mint p-5 md:col-span-2 sm:p-7">
        <p class="fig">Display · ESP32</p>
        <h3 class="mt-2 text-xl font-extrabold">P10 LED matrix</h3>
        <p class="mt-2 text-[15px] leading-relaxed">AVR → ESP32 port with 0–100% PWM-on-OE brightness. See DBG-01.</p>
      </article>
    </div>

    <!-- parts drawer -->
    <div class="mt-16">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <h3 class="display text-3xl sm:text-4xl" data-split>Parts drawer</h3>
        <p class="marker-blue -rotate-1 text-lg">datasheets read at 2 am</p>
      </div>
      <div class="grid grid-cols-2 border-l-2 border-t-2 border-ink sm:grid-cols-3 lg:grid-cols-6" data-reveal-stagger>
        <div class="border-b-2 border-r-2 border-ink bg-white p-3 sm:p-4">
          <p class="flex justify-between font-mono text-[11px] font-bold"><span>U2</span><span>LGA-14</span></p>
          <div class="mini" aria-hidden="true"><div class="iso" style="width:100px;height:76px"><div class="lay" style="background:#B81402"></div><div class="lay" style="background:#FF220F;border:2px solid #0B0B14;transform:translateZ(5px)"></div><div class="p3" style="position:absolute;left:34px;top:22px;width:32px;height:32px"><div class="lay" style="background:#0B0B14;transform:translateZ(8px)"></div><div class="lay" style="background:#1C1C2A;transform:translateZ(12px)"></div></div></div></div>
          <p class="font-bold">ADXL345</p><p class="font-mono text-[12px] text-muted">3-axis accel · I2C</p>
        </div>
        <div class="border-b-2 border-r-2 border-ink bg-white p-3 sm:p-4">
          <p class="flex justify-between font-mono text-[11px] font-bold"><span>U5</span><span>MODULE</span></p>
          <div class="mini" aria-hidden="true"><div class="iso" style="width:130px;height:60px"><div class="lay" style="background:#00008A"></div><div class="lay" style="background:#0000C4;border:2px solid #0B0B14;transform:translateZ(5px)"></div>{[8, 82].map((l) => (<div class="p3" style={`position:absolute;left:${l}px;top:10px;width:40px;height:40px;border-radius:50%`}><div class="lay" style="background:#A8A8B2;transform:translateZ(8px)"></div><div class="lay" style="background:#C8C8D0;transform:translateZ(16px)"></div><div class="lay" style="background:radial-gradient(circle,#0B0B14 34%,#F7F7F4 37%);border:2px solid #0B0B14;transform:translateZ(24px)"></div></div>))}</div></div>
          <p class="font-bold">Ultrasonic</p><p class="font-mono text-[12px] text-muted">40 kHz echo</p>
        </div>
        <div class="border-b-2 border-r-2 border-ink bg-white p-3 sm:p-4">
          <p class="flex justify-between font-mono text-[11px] font-bold"><span>M1</span><span>PWM</span></p>
          <div class="mini" aria-hidden="true"><div class="iso" style="width:76px;height:42px"><div class="lay" style="background:#0B0B14"></div><div class="lay" style="background:#1C1C2A;transform:translateZ(10px)"></div><div class="lay" style="background:#1C1C2A;transform:translateZ(20px)"></div><div class="lay" style="background:#2A2A3A;border:2px solid #0B0B14;transform:translateZ(30px)"></div><div class="rf-horn" style="position:absolute;left:4px;top:15px;width:52px;height:12px;border-radius:6px;background:#FEEA4D;border:2px solid #0B0B14;transform-origin:14px 6px"></div></div></div>
          <p class="font-bold">Servo</p><p class="font-mono text-[12px] text-muted">50 Hz frame</p>
        </div>
        <div class="border-b-2 border-r-2 border-ink bg-white p-3 sm:p-4">
          <p class="flex justify-between font-mono text-[11px] font-bold"><span>U3</span><span>WROOM</span></p>
          <div class="mini" aria-hidden="true"><div class="iso" style="width:110px;height:80px"><div class="lay" style="background:#00A07C"></div><div class="lay" style="background:#00D8A7;border:2px solid #0B0B14;transform:translateZ(5px)"></div><div class="p3" style="position:absolute;left:10px;top:26px;width:74px;height:46px"><div class="lay" style="background:#A8A8B2;transform:translateZ(8px)"></div><div class="lay" style="background:#F7F7F4;border:2px solid #0B0B14;transform:translateZ(14px)"></div></div></div>
            <svg width="62" height="52" viewBox="0 0 120 100" style="position:absolute;right:6px;top:4px"><path class="rf-ping" d="M40 70 A28 28 0 0 1 80 70" fill="none" stroke="#FF220F" stroke-width="8" stroke-linecap="round" /><path class="rf-ping2" d="M26 56 A48 48 0 0 1 94 56" fill="none" stroke="#FF220F" stroke-width="8" stroke-linecap="round" /><path class="rf-ping3" d="M12 42 A68 68 0 0 1 108 42" fill="none" stroke="#FF220F" stroke-width="8" stroke-linecap="round" /></svg>
          </div>
          <p class="font-bold">ESP32</p><p class="font-mono text-[12px] text-muted">Wi-Fi · BLE</p>
        </div>
        <div class="border-b-2 border-r-2 border-ink bg-white p-3 sm:p-4">
          <p class="flex justify-between font-mono text-[11px] font-bold"><span>S1</span><span>DIGITAL</span></p>
          <div class="mini" aria-hidden="true"><div class="iso" style="width:84px;height:84px"><div class="lay" style="background:#D9C33A"></div><div class="lay" style="background:#FEEA4D;border:2px solid #0B0B14;transform:translateZ(5px)"></div><div class="p3" style="position:absolute;left:14px;top:14px;width:56px;height:56px;border-radius:50%"><div class="lay" style="background:#C8C8D0;transform:translateZ(8px)"></div><div class="lay" style="inset:4px;background:#DCDCE2;transform:translateZ(14px)"></div><div class="lay" style="inset:9px;background:#ECECF0;transform:translateZ(20px)"></div><div class="lay" style="inset:16px;background:#FFFFFF;border:2px solid #0B0B14;transform:translateZ(25px)"></div></div></div></div>
          <p class="font-bold">PIR sensor</p><p class="font-mono text-[12px] text-muted">presence · motion</p>
        </div>
        <div class="border-b-2 border-r-2 border-ink bg-white p-3 sm:p-4">
          <p class="flex justify-between font-mono text-[11px] font-bold"><span>D1</span><span>5 MM</span></p>
          <div class="mini" aria-hidden="true"><div class="iso" style="width:90px;height:60px"><div class="lay" style="background:#00008A"></div><div class="lay" style="background:#0000C4;border:2px solid #0B0B14;transform:translateZ(5px)"></div><div class="p3" style="position:absolute;left:30px;top:16px;width:28px;height:28px;border-radius:50%"><div class="lay" style="background:#B81402;transform:translateZ(8px)"></div><div class="lay" style="background:#D91B0A;transform:translateZ(14px)"></div><div class="lay rf-blink" style="background:#FF220F;border:2px solid #0B0B14;transform:translateZ(20px)"></div></div></div></div>
          <p class="font-bold">The LED</p><p class="font-mono text-[12px] text-muted">where it all starts</p>
        </div>
      </div>
    </div>
  </div>
</section>
